# ==============================================================================
# CodeWhy — Environment Configuration Example
# ==============================================================================
# Copy this file to `.env` (or `.env.local` for local Next.js overrides) and fill in
# your Neo4j and Sarvam AI credentials.
#
# IMPORTANT:
# - Never commit your real `.env` file containing secrets to version control.
# - If either service is not configured, CodeWhy gracefully falls back to local
#   in-memory AST analysis and rule-based reasoning engines.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neo4j Graph Database Configuration
# ------------------------------------------------------------------------------
# Connects CodeWhy's Architecture Explorer, Blast Radius Impact Analysis,
# and Codebase Knowledge Graph to a real Neo4j instance.
#
# Options:
# - Local Neo4j (Docker / Desktop): neo4j://localhost:7687 or bolt://localhost:7687
# - Neo4j AuraDB (Cloud): neo4j+s://<your-db-id>.databases.neo4j.io
#
# Default username for local instances is usually `neo4j`.
# Database defaults to `neo4j` if left unset.

NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# 2. Sarvam AI Configuration
# ------------------------------------------------------------------------------
# Powers CodeWhy's Ask Why engineering intelligence engine with evidence-grounded
# architecture explanations.
#
# Sign up and obtain an API key at: https://sarvam.ai/
# Official Documentation: https://docs.sarvam.ai/api/api-guides-tutorials/chat-completion/overview
#
# Default Model: `sarvam-105b` (flagship reasoning model)
# Endpoint: https://api.sarvam.ai/v1/chat/completions

SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b
SARVAM_API_ENDPOINT=https://api.sarvam.ai/v1/chat/completions

# ------------------------------------------------------------------------------
# 3. CodeWhy Application Configuration (Optional)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL=http://localhost:3000
